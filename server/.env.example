# docker-compose 使用的环境变量。复制为 .env 后按需修改：cp .env.example .env
#
# 注意：这里的 MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE
#       必须与 config.json 里的 MySQLUser / MySQLPass / MySQLDB 完全一致。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=ReadingCoach
MYSQL_USER=readingcoach
MYSQL_PASSWORD=change-this-password
# 宿主机映射端口（供外部工具直连，可改成不常用端口或删除 compose 里的 ports 段来关闭外部访问）
MYSQL_PORT=3306

# ---- Server ----
SERVER_PORT=8080

# ---- 通用 ----
TZ=Asia/Shanghai
# 国内服务器构建慢时可改为 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
